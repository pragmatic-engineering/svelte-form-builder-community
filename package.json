{
	"name": "@pragmatic-engineering/svelte-form-builder-community",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/pragmatic-engineering/svelte-form-builder-community.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && svelte-package",
		"sk-publish": "cd package && npm publish",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/lodash.clonedeep": "^4.5.7",
		"@types/lodash.merge": "^4.6.7",
		"@types/node": "^26.6.4",
		"@types/signature_pad": "^2.3.2",
		"@types/tabulator-tables": "5.5.3",
		"@types/tinymce": "^4.6.5",
		"@typescript-eslint/eslint-plugin": "^5.27.0",
		"@typescript-eslint/parser": "^5.27.0",
		"eslint": "^8.16.0",
		"eslint-config-prettier": "^8.3.0",
		"eslint-plugin-svelte": "^2.30.0",
		"prettier": "^3.4.0",
		"prettier-plugin-svelte": "^4.0.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-preprocess": "^5.0.3",
		"tslib": "^2.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.3"
	},
	"dependencies": {
		"balloon-css": "^1.2.0",
		"lodash.clonedeep": "^4.5.0",
		"lodash.merge": "^4.6.2",
		"nanoid": "^4.0.0",
		"pretty-checkbox": "^3.0.3",
		"svelte-sonner": "^2.0.0",
		"svelecte": "5.4.0"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	}
}
